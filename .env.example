# Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# Kosong = semua user boleh memakai bot.
# Isi misalnya: 123456789,987654321
ALLOWED_USER_IDS=

# Konfigurasi opsional
METEORA_API_URL=https://dlmm.datapi.meteora.ag
METEORA_PAGE_SIZE=1000
METEORA_MAX_PAGES=20
MAX_POOLS_IN_MESSAGE=10
# Pool di bawah nilai ini tidak dipakai untuk perhitungan APR agar tidak menghasilkan angka ekstrem.
MIN_POOL_TVL_USD=1000
USER_COOLDOWN_SECONDS=5

# Integrasi EVM / Uniswap V3 (opsional untuk fitur Solana)
UNISWAP_API_KEY=
THE_GRAPH_API_KEY=
# Chain bot: Ethereum=1, Arbitrum=42161, BSC=56, Robinhood=4663, Arc=5042, Base=8453.
# Format: CHAIN_ID:SUBGRAPH_ID;CHAIN_ID:SUBGRAPH_ID
# Ethereum mainnet otomatis tersedia; tambahkan chain lain dari Graph Explorer.
UNISWAP_SUBGRAPH_IDS=1:5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
UNISWAP_MAX_POOLS=10

# File state alert disimpan lokal di alerts.json dan otomatis diabaikan Git.
